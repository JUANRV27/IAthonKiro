# URL base del backend (API Gateway). Solo se usa cuando VITE_USE_MOCK=false.
VITE_API_URL=http://localhost:3000

# Modo mock: "true" usa datos locales de src/data/mock.js sin llamar al backend.
VITE_USE_MOCK=true

# Clave de Google Maps para el mapa de riesgo (dejar vacía en modo mock).
VITE_GOOGLE_MAPS_KEY=
